# 阿里云百炼 DashScope API Key。
# 请复制本文件为 .env，再填入自己的 Key；不要提交 .env。
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key

# 可选：覆盖实时同传 WebSocket 网关，默认使用 DashScope 公网端点。
QWEN_REALTIME_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=qwen3.8-livetranslate-flash-realtime

# 翻译目标语言：en、zh、ja 等。
TARGET_LANGUAGE=en

# 音频切片参数。
SAMPLE_RATE=16000
CHUNK_SIZE=1600
