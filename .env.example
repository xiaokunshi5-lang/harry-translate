# 服务监听地址 (默认 127.0.0.1 仅本机安全访问；如需手机或局域网其它电脑访问 /en /zh 大屏，可改为 0.0.0.0)
HOST=127.0.0.1

# 服务运行端口 (默认 8000)
PORT=8000

# 默认同传引擎 (qwen3.8-livetranslate-flash-realtime 或 gummy-realtime-v1)
DEFAULT_ENGINE=qwen3.8-livetranslate-flash-realtime

# 阿里云百炼 API Key (请前往阿里云百炼控制台获取)
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key

# 阿里云千问 Qwen 实时同传 WebSocket 接口地址 (默认走阿里云百炼官方公网网关，普通 API Key 开箱即用)
# 仅当你使用 sk-ws- 开头的「业务空间专属 Key」时，才需要改成你自己的专属端点，格式如：
# QWEN_REALTIME_WS_URL=wss://<你的实例ID>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime?model=qwen3.8-livetranslate-flash-realtime
QWEN_REALTIME_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=qwen3.8-livetranslate-flash-realtime

# 翻译目标语言 (en: 英语, zh: 中文, ja: 日语, etc.)
TARGET_LANGUAGE=en

# 音频切片参数 (v3.0 默认 50ms 微切片 / 1600 字节 / 800 采样点)
SAMPLE_RATE=16000
CHUNK_SIZE=1600

# Token 计费看板单价配置 (可选，单位：元/百万Token，默认输入 40 元/M、输出 100 元/M)
INPUT_TOKEN_PRICE_PER_M=40.0
OUTPUT_TOKEN_PRICE_PER_M=100.0

